# ==============================================================================
# Takerin - Environment Variables Template
# Salin file ini menjadi `.env` untuk konfigurasi environment lokal Anda:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare D1 & Drizzle ORM
# (Opsional untuk development lokal dengan Miniflare; Wajib untuk Drizzle Studio / migrasi remote)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID : Cloudflare Account ID dari dashboard Cloudflare
# CLOUDFLARE_DATABASE_ID: UUID Database D1 'takerin-db'
# CLOUDFLARE_D1_TOKEN   : API Token Cloudflare dengan izin membaca dan menulis D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Better Auth (Otentikasi & Sesi Pengguna)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Kunci rahasia minimal 32 karakter untuk hashing & enkripsi sesi.
# Dapat dibuat dengan menjalankan: `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-32-character-secret-key-change-me"

# BETTER_AUTH_URL: URL origin aplikasi tempat otentikasi dijalankan.
# Lokal: http://localhost:5173
# Production: https://takerin.my.id
BETTER_AUTH_URL="http://localhost:5173"

# ADMIN_EMAILS: Daftar email administrator pertama/sistem (dipisahkan tanda koma).
# Pengguna yang mendaftar atau memiliki sesi aktif dengan email ini otomatis mendapatkan role 'admin'.
# Contoh: ADMIN_EMAILS="admin@takerin.my.id,owner@takerin.my.id"
ADMIN_EMAILS=""

# ------------------------------------------------------------------------------
# 3. Resend (Layanan Email Transaksional: Verifikasi Email, OTP 2FA, Reset Password)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: API Key dari akun Resend (https://resend.com/api-keys).
# Jika dikosongkan pada mode lokal, email service otomatis memakai mock mode (output log ke terminal).
RESEND_API_KEY=""

# EMAIL_FROM: Alamat email pengirim.
# Default sandbox/testing: Takerin <onboarding@resend.dev>
# Production: Takerin <noreply@takerin.my.id> (setelah verifikasi domain takerin.my.id di Resend)
EMAIL_FROM="Takerin <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. AI Services (Groq Llama 3.3 70B & Google Gemini Flash)
# ------------------------------------------------------------------------------
# GROQ_API_KEY: API Key Groq untuk inferensi Llama 3.3 70B (https://console.groq.com/keys)
GROQ_API_KEY=""

# GEMINI_API_KEY: API Key Google AI Studio untuk Gemini Flash (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

